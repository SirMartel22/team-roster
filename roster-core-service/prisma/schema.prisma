generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Church {
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  slug             String                 @unique
  createdAt        DateTime?              @default(now()) @map("created_at") @db.Timestamptz(6)
  duties           Duty[]
  members          Member[]
  notificationLogs NotificationLog[]
  rosters          Roster[]
  subunits         Subunit[]
  users            User[]
  invitations      Invitation[]
  switchRequests   SubunitSwitchRequest[]
  auditLogs        AuditLog[]

  @@map("churches")
}

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  churchId     String    @map("church_id") @db.Uuid
  email        String
  passwordHash String    @map("password_hash")
  role         String    @default("member")
  name         String
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  member       Member?
  church       Church    @relation(fields: [churchId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([churchId, email])
  @@map("users")
}

model Subunit {
  id                 String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  churchId           String                 @map("church_id") @db.Uuid
  name               String
  createdAt          DateTime?              @default(now()) @map("created_at") @db.Timestamptz(6)
  duties             Duty[]
  members            Member[]
  church             Church                 @relation(fields: [churchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  switchRequestsFrom SubunitSwitchRequest[] @relation("SwitchFromSubunit")
  switchRequestsTo   SubunitSwitchRequest[] @relation("SwitchToSubunit")

  @@unique([churchId, name])
  @@map("subunits")
}

model Member {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  churchId       String                 @map("church_id") @db.Uuid
  userId         String                 @unique @map("user_id") @db.Uuid
  subunitId      String                 @map("subunit_id") @db.Uuid
  phone          String?
  whatsapp       String?
  isActive       Boolean                @default(true) @map("is_active")
  createdAt      DateTime?              @default(now()) @map("created_at") @db.Timestamptz(6)
  church         Church                 @relation(fields: [churchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subunit        Subunit                @relation(fields: [subunitId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user           User                   @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rosters        Roster[]
  switchRequests SubunitSwitchRequest[]

  @@map("members")
}

model Duty {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  churchId  String    @map("church_id") @db.Uuid
  subunitId String    @map("subunit_id") @db.Uuid
  name      String
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  church    Church    @relation(fields: [churchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subunit   Subunit   @relation(fields: [subunitId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rosters   Roster[]

  @@map("duties")
}

model Roster {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  churchId           String            @map("church_id") @db.Uuid
  dutyId             String            @map("duty_id") @db.Uuid
  memberId           String            @map("member_id") @db.Uuid
  serviceDate        DateTime          @map("service_date") @db.Date
  status             String            @default("scheduled")
  attended           Boolean?
  attendanceMarkedAt DateTime?         @map("attendance_marked_at") @db.Timestamptz(6)
  attendanceMarkedBy String?           @map("attendance_marked_by") @db.Uuid
  createdAt          DateTime?         @default(now()) @map("created_at") @db.Timestamptz(6)
  notificationLogs   NotificationLog[]
  church             Church            @relation(fields: [churchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  duty               Duty              @relation(fields: [dutyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  member             Member            @relation(fields: [memberId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([dutyId, serviceDate])
  @@map("rosters")
}

model NotificationLog {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  churchId       String    @map("church_id") @db.Uuid
  rosterId       String?   @map("roster_id") @db.Uuid
  channel        String
  status         String    @default("pending")
  idempotencyKey String?   @unique @map("idempotency_key")
  errorMessage   String?   @map("error_message")
  recipient      String?
  eventType      String?   @map("event_type")
  sentAt         DateTime? @map("sent_at") @db.Timestamptz(6)
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  church         Church    @relation(fields: [churchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  roster         Roster?   @relation(fields: [rosterId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("notifications_logs")
}

model Invitation {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  churchId   String    @map("church_id") @db.Uuid
  email      String
  role       String    @default("member")
  tokenHash  String    @unique @map("token_hash")
  status     String    @default("pending")
  invitedBy  String    @map("invited_by") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  church     Church    @relation(fields: [churchId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([churchId, status])
  @@map("invitations")
}

model SubunitSwitchRequest {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  churchId      String    @map("church_id") @db.Uuid
  memberId      String    @map("member_id") @db.Uuid
  fromSubunitId String    @map("from_subunit_id") @db.Uuid
  toSubunitId   String    @map("to_subunit_id") @db.Uuid
  status        String    @default("pending")
  decisionNote  String?   @map("decision_note")
  requestedAt   DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  decidedAt     DateTime? @map("decided_at") @db.Timestamptz(6)
  decidedBy     String?   @map("decided_by") @db.Uuid
  church        Church    @relation(fields: [churchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  member        Member    @relation(fields: [memberId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fromSubunit   Subunit   @relation("SwitchFromSubunit", fields: [fromSubunitId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  toSubunit     Subunit   @relation("SwitchToSubunit", fields: [toSubunitId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([churchId, status])
  @@map("subunit_switch_requests")
}

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  churchId    String   @map("church_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id") @db.Uuid
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  church      Church   @relation(fields: [churchId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([churchId, createdAt])
  @@map("audit_logs")
}
